{
  "name": "hypemove-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender && npm run check",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "check": "node scripts/check-site.mjs",
    "images": "node scripts/optimize-images.mjs && node scripts/crop-play-screenshots.mjs",
    "og": "node scripts/og-images.mjs",
    "preview": "vite preview",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.79.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "playwright": "^1.63.0",
    "postcss": "^8.4.38",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.2"
  }
}
